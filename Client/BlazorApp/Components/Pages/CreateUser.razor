
@page "/create-user"
@using ApiContracts.Users
@using BlazorApp.Services
@inject IUserService UserService
@inject NavigationManager NavMgr

<PageTitle>Create User</PageTitle>

<h3>Create a New User</h3>

<div class="form-group mb-3">
    <label>Username:</label>
    <input type="text" @bind="username" class="form-control" />
</div>

<div class="form-group mb-3">
    <label>Password:</label>
    <input type="password" @bind="password" class="form-control" />
</div>

@if (!string.IsNullOrEmpty(errorLabel))
{
    <label style="color: red">@errorLabel</label>
    <br/>
}

<button class="btn btn-primary" @onclick="() => CreateNewUserAsync()">Create User</button>

@code {
    private string username = "";
    private string password = "";
    private string errorLabel = "";

    private async Task CreateNewUserAsync()
    {
        errorLabel = "";

        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            errorLabel = "Username and password are required.";
            return;
        }

        try
        {
            CreateUserDto newUser = new CreateUserDto
            {
                Username = username,
                Password = password
            };

            await UserService.AddUserAsync(newUser);
            NavMgr.NavigateTo("/");
        }
        catch (Exception e)
        {
            Console.WriteLine(e);
            errorLabel = $"Error: {e.Message}";
        }
    }
}